{
  "info": {
    "_postman_id": "d9df91fc-f4a3-4df5-b2dd-4eb18a93b703",
    "name": "Lily Pets API",
    "description": "Colección para probar la API de Lily Pets. Postman conserva automáticamente la cookie HttpOnly `pet_session` después de iniciar sesión. Ejecuta el login administrativo antes del CRUD de categorías y productos, y el registro/login de cliente antes de favoritos, carrito y pedidos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('customerEmail')) {",
          "  pm.environment.set('customerEmail', `cliente-${Date.now()}@lilypets.local`);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Estado y catálogo",
      "item": [
        {
          "name": "Estado de la API y PostgreSQL",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Comprueba que la API está iniciada y PostgreSQL conectado."
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": ["pm.test('API y base conectadas', () => {", "  pm.response.to.have.status(200);", "  pm.expect(pm.response.json().database).to.eql('connected');", "});"] }
          }]
        },
        {
          "name": "Listar productos",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/products" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Devuelve productos', () => {", "  pm.response.to.have.status(200);", "  pm.expect(pm.response.json()).to.be.an('array');", "});"] } }]
        },
        {
          "name": "Ver producto",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/products/{{productId}}" }
        },
        {
          "name": "Listar categorías",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/categories" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Devuelve categorías', () => {", "  pm.response.to.have.status(200);", "  pm.expect(pm.response.json()).to.be.an('array');", "});"] } }]
        }
      ]
    },
    {
      "name": "01B - Configuración de tienda",
      "item": [
        {
          "name": "Consultar tema guardado",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/settings" }
        },
        {
          "name": "Cambiar tema permanente",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"theme\": \"{{theme}}\"\n}" },
            "url": "{{baseUrl}}/settings/theme",
            "description": "Requiere sesión administrativa. Valores: winter, spring, summer, autumn o permanente."
          }
        },
        {
          "name": "Guardar imagen principal",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"species\": \"perros\",\n  \"image\": \"{{uploadedImageUrl}}\"\n}" },
            "url": "{{baseUrl}}/settings/hero",
            "description": "Requiere sesión administrativa. Usa perros o gatos y una URL normal o uploadedImageUrl."
          }
        }
      ]
    },
    {
      "name": "02 - Autenticación",
      "item": [
        {
          "name": "Registrar cliente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Cliente Postman\",\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}" },
            "url": "{{baseUrl}}/auth/register",
            "description": "Crea un cliente e inicia su sesión. Si el correo ya existe, cambia customerEmail o ejecuta Reiniciar cliente de prueba."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Cliente registrado', () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));"] } }]
        },
        {
          "name": "Login cliente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Sesión de cliente iniciada', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Login administrador",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" },
            "url": "{{baseUrl}}/auth/login",
            "description": "Completa adminPassword en el entorno antes de enviar."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Administrador autenticado', () => {", "  pm.response.to.have.status(200);", "  pm.expect(pm.response.json().user.role).to.eql('admin');", "});"] } }]
        },
        {
          "name": "Consultar mi sesión",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/auth/me" }
        },
        {
          "name": "Cerrar sesión",
          "request": { "method": "POST", "header": [], "url": "{{baseUrl}}/auth/logout" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Sesión cerrada', () => pm.response.to.have.status(204));"] } }]
        },
        {
          "name": "Reiniciar correo del cliente de prueba",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/health", "description": "Genera un correo distinto para realizar un nuevo registro." },
          "event": [{ "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["pm.environment.set('customerEmail', `cliente-${Date.now()}@lilypets.local`);"] } }]
        }
      ]
    },
    {
      "name": "03 - Administración de categorías",
      "description": "Requiere ejecutar antes Login administrador.",
      "item": [
        {
          "name": "Crear categoría",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"label\": \"Categoría Postman {{$timestamp}}\",\n  \"species\": \"perros\",\n  \"image\": \"https://images.unsplash.com/photo-1558788353-f76d92427f16\"\n}" },
            "url": "{{baseUrl}}/categories"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Categoría creada', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.environment.set('categoryId', pm.response.json().id);"] } }]
        },
        {
          "name": "Actualizar categoría",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"label\": \"Categoría Postman actualizada\",\n  \"species\": \"perros\",\n  \"image\": \"https://images.unsplash.com/photo-1558788353-f76d92427f16\",\n  \"count\": \"0 productos\"\n}" },
            "url": "{{baseUrl}}/categories/{{categoryId}}"
          }
        },
        {
          "name": "Eliminar categoría",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/categories/{{categoryId}}",
            "description": "Ejecuta primero Eliminar producto si la categoría contiene productos."
          }
        }
      ]
    },
    {
      "name": "03B - Carga de imágenes",
      "description": "Requiere sesión administrativa. Selecciona un archivo en la pestaña Body antes de enviar.",
      "item": [
        {
          "name": "Subir imagen desde el equipo",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "image/jpeg" }],
            "body": { "mode": "file", "file": { "src": [] } },
            "url": "{{baseUrl}}/uploads/images",
            "description": "Acepta JPG, PNG, WebP o GIF de hasta 5 MB. Ajusta Content-Type para que coincida con el archivo seleccionado."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Imagen subida', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.environment.set('uploadedImageUrl', pm.response.json().url);"] } }]
        }
      ]
    },
    {
      "name": "03C - Administración de anuncios",
      "description": "Los anuncios activos aparecen bajo el buscador y cambian según durationSeconds.",
      "item": [
        {
          "name": "Listar anuncios",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/announcements" }
        },
        {
          "name": "Crear anuncio",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Oferta creada desde Postman\",\n  \"subtitle\": \"Anuncio rotativo de prueba\",\n  \"image\": \"{{uploadedImageUrl}}\",\n  \"link\": \"#productos\",\n  \"active\": true,\n  \"durationSeconds\": 6,\n  \"sortOrder\": 10\n}" },
            "url": "{{baseUrl}}/announcements"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Anuncio creado', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.environment.set('announcementId', pm.response.json().id);"] } }]
        },
        {
          "name": "Actualizar anuncio",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Oferta Postman actualizada\",\n  \"subtitle\": \"Texto actualizado\",\n  \"image\": \"{{uploadedImageUrl}}\",\n  \"link\": \"#categorias\",\n  \"active\": true,\n  \"durationSeconds\": 8,\n  \"sortOrder\": 10\n}" },
            "url": "{{baseUrl}}/announcements/{{announcementId}}"
          }
        },
        {
          "name": "Eliminar anuncio",
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/announcements/{{announcementId}}" }
        }
      ]
    },
    {
      "name": "04 - Administración de productos",
      "description": "Requiere sesión administrativa y categoryId. Puedes crear antes una categoría de prueba.",
      "item": [
        {
          "name": "Crear producto",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"categoryId\": {{categoryId}},\n  \"category\": \"Categoría Postman actualizada\",\n  \"name\": \"Producto creado desde Postman\",\n  \"desc\": \"Producto utilizado para probar la API.\",\n  \"price\": 4990,\n  \"original\": 5990,\n  \"rating\": 4.5,\n  \"reviews\": 0,\n  \"badge\": \"Nuevo\",\n  \"badgeColor\": \"orange\",\n  \"image\": \"https://images.unsplash.com/photo-1583337130417-3346a1be7dee\",\n  \"inventory\": 20,\n  \"status\": \"Activo\",\n  \"tags\": [\"Nuevo\"]\n}" },
            "url": "{{baseUrl}}/products"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Producto creado', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.environment.set('productId', pm.response.json().id);"] } }]
        },
        {
          "name": "Actualizar producto",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"categoryId\": {{categoryId}},\n  \"category\": \"Categoría Postman actualizada\",\n  \"name\": \"Producto Postman actualizado\",\n  \"desc\": \"Descripción actualizada desde Postman.\",\n  \"price\": 5490,\n  \"original\": 6490,\n  \"rating\": 4.7,\n  \"reviews\": 1,\n  \"badge\": \"Oferta\",\n  \"badgeColor\": \"red\",\n  \"image\": \"https://images.unsplash.com/photo-1583337130417-3346a1be7dee\",\n  \"inventory\": 15,\n  \"status\": \"Activo\",\n  \"tags\": [\"Oferta\"]\n}" },
            "url": "{{baseUrl}}/products/{{productId}}"
          }
        },
        {
          "name": "Eliminar producto",
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/products/{{productId}}" }
        }
      ]
    },
    {
      "name": "05 - Favoritos",
      "description": "Requiere una sesión de cliente.",
      "item": [
        { "name": "Listar favoritos", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/favorites" } },
        { "name": "Agregar favorito", "request": { "method": "POST", "header": [], "url": "{{baseUrl}}/favorites/{{productId}}" } },
        { "name": "Eliminar favorito", "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/favorites/{{productId}}" } }
      ]
    },
    {
      "name": "06 - Carrito",
      "description": "Requiere una sesión de cliente.",
      "item": [
        { "name": "Consultar carrito", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/cart" } },
        {
          "name": "Agregar o cambiar cantidad",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"quantity\": 2\n}" },
            "url": "{{baseUrl}}/cart/{{productId}}"
          }
        },
        {
          "name": "Sincronizar carrito",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"items\": [\n    { \"productId\": {{productId}}, \"qty\": 2 }\n  ]\n}" },
            "url": "{{baseUrl}}/cart/sync"
          }
        },
        { "name": "Eliminar del carrito", "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/cart/{{productId}}" } }
      ]
    },
    {
      "name": "07 - Pedidos",
      "description": "Requiere sesión de cliente y al menos un producto en el carrito.",
      "item": [
        {
          "name": "Crear pedido",
          "request": { "method": "POST", "header": [], "url": "{{baseUrl}}/orders" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Pedido creado', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.environment.set('orderId', pm.response.json().id);"] } }]
        },
        { "name": "Listar mis pedidos", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/orders" } }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api", "type": "string" },
    { "key": "productId", "value": "1", "type": "string" },
    { "key": "categoryId", "value": "1", "type": "string" }
  ]
}
