generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Cliente {
  rut_cliente      String   @id @db.VarChar(12)
  nombre           String   @db.VarChar(100)
  telefono         String   @db.VarChar(20)
  email            String   @db.VarChar(150)
  fecha_nacimiento DateTime @db.Date

  // Relación 1:N con Cita
  citas            Cita[]

  @@map("CLIENTE")
}

model Tatuador {
  id_tatuador      String   @id @db.VarChar(20)
  nombre           String   @db.VarChar(100)
  telefono         String   @db.VarChar(20)
  email            String   @db.VarChar(150)
  nombre_artistico String   @db.VarChar(100)
  especialidad     String   @db.VarChar(100)
  portafolio_web   String   @db.VarChar(200)
  disponibilidad   String   @db.VarChar(100)

  // Relación 1:N con Cita
  citas            Cita[]

  @@map("TATUADOR")
}

model Diseno {
  id_diseno        String   @id @db.VarChar(20)
  boceto           String   @db.VarChar(200)
  comentarios      String   @db.VarChar(400)
  autor            String   @db.VarChar(100)
  derechos_uso     String   @db.VarChar(400)
  fecha_creacion   DateTime @db.Date
  disponible       Boolean

  // Relación 1:N con Cita
  citas            Cita[]

  @@map("DISENO")
}

model Cita {
  id_cita          String   @id @db.VarChar(20)
  fecha            DateTime @db.Date
  hora             DateTime @db.Time
  estado           String   @db.VarChar(30)
  fecha_creacion   DateTime @db.Date
  usuario_creador  String   @db.VarChar(50)
  rut_cliente      String   @db.VarChar(12)
  id_tatuador      String   @db.VarChar(20)
  id_diseno        String   @db.VarChar(20)

  // Claves Foráneas
  cliente          Cliente  @relation(fields: [rut_cliente], references: [rut_cliente])
  tatuador         Tatuador @relation(fields: [id_tatuador], references: [id_tatuador])
  diseno           Diseno   @relation(fields: [id_diseno], references: [id_diseno])

  // Relaciones 1:N hacia Pago y Procedimiento
  pagos            Pago[]
  procedimientos   Procedimiento[]

  @@map("CITA")
}

model Pago {
  id_pago          String   @id @db.VarChar(20)
  monto            Decimal  @db.Decimal(12, 2)
  metodo_pago      String   @db.VarChar(50)
  estado           String   @db.VarChar(30)
  fecha            DateTime @db.Date
  id_cita          String   @db.VarChar(20)

  // Clave Foránea
  cita             Cita     @relation(fields: [id_cita], references: [id_cita])

  @@map("PAGO")
}

model Procedimiento {
  id_procedimiento String   @id @db.VarChar(20)
  area_corporal    String   @db.VarChar(100)
  descripcion      String   @db.VarChar(400)
  fecha_ejecucion  DateTime @db.Date
  fecha_creacion   DateTime @db.Date
  usuario_creador  String   @db.VarChar(50)
  completado       Boolean
  id_cita          String   @db.VarChar(20)

  // Clave Foránea
  cita             Cita     @relation(fields: [id_cita], references: [id_cita])

  // Relación N:M explícita hacia Insumo
  insumos_utilizados ProcedimientoInsumo[]

  @@map("PROCEDIMIENTO")
}

model Insumo {
  id_insumo        String   @id @db.VarChar(20)
  nombre           String   @db.VarChar(150)
  tipo             String   @db.VarChar(100)
  cantidad         Int
  fecha_ingreso    DateTime @db.Date
  // Marcado como opcional (?) ya que algunos insumos podrían no tener vencimiento
  fecha_vencimiento DateTime? @db.Date 
  responsable_uso  String   @db.VarChar(100)
  perecible        Boolean

  // Relación N:M explícita hacia Procedimiento
  procedimientos   ProcedimientoInsumo[]

  @@map("INSUMO")
}

// Tabla Intermedia (Join Table) explícita por contener el atributo 'CANTIDAD_UTILIZADA'
model ProcedimientoInsumo {
  id_procedimiento   String   @db.VarChar(20)
  id_insumo          String   @db.VarChar(20)
  cantidad_utilizada Int

  // Claves Foráneas
  procedimiento      Procedimiento @relation(fields: [id_procedimiento], references: [id_procedimiento])
  insumo             Insumo        @relation(fields: [id_insumo], references: [id_insumo])

  // Llave Primaria Compuesta
  @@id([id_procedimiento, id_insumo])
  @@map("PROCEDIMIENTO_INSUMO")
}